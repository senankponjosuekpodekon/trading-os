{
  "name": "trading-os",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@trading-os/web --filter=@trading-os/api",
    "dev:web": "turbo run dev --filter=@trading-os/web",
    "dev:api": "turbo run dev --filter=@trading-os/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:studio": "npm run db:studio --workspace=apps/api"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@nestjs/throttler": "^6.5.0",
    "helmet": "^8.2.0",
    "turbo": "^2.5.4",
    "typescript": "^5.9.3"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/websockets": "^11.1.28",
    "@prisma/client": "^6.19.3",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.79.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.11.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "overrides": {
    "@opentelemetry/core": ">=2.8.0",
    "deepmerge-ts": ">=8.0.0",
    "postcss": "^8.5.24",
    "sharp": "^0.35.0",
    "uuid": "^11.1.1"
  }
}
