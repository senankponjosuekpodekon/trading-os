# Required: full DB URL for the production Postgres instance.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/trading_os?schema=public

# JWT configuration
JWT_SECRET=change_me_to_a_256_bit_secret
JWT_EXPIRES_IN=15m

# API base URL used by the web app
NEXT_PUBLIC_API_URL=https://api.trading-os.example

# CORS / security
FRONTEND_ORIGIN=https://trading-os.example

# OpenAI / Anthropic API key for AI copilot
OPENAI_API_KEY=sk-...

# Binance public endpoint (no key needed)
BINANCE_API_URL=https://api.binance.com

# Optional third-party market data providers
FEAR_GREED_URL=https://api.alternative.me/fng/
SOCRATA_COT_APP_TOKEN=...
