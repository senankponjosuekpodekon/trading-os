# Required: full DB URL for the production Postgres instance, using the
# owner/superuser role — used for `prisma migrate deploy` and by cron/system
# jobs (PrismaSystemService) that legitimately need cross-user access.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/trading_os?schema=public

# Required: DB URL using the low-privilege `app_runtime` role (see
# apps/api/prisma/migrations/20260729_add_rls) — used by the default
# request-scoped PrismaService, enforced by Postgres Row-Level Security.
APP_RUNTIME_DATABASE_URL=postgresql://app_runtime:change_me@postgres:5432/trading_os?schema=public

# JWT configuration
JWT_SECRET=change_me_to_a_256_bit_secret
JWT_EXPIRES_IN=15m
ADMIN_PASSWORD=change_me_to_a_strong_password

# API base URL used by the web app
NEXT_PUBLIC_API_URL=https://api.trading-os.example

# CORS / security
FRONTEND_ORIGIN=https://trading-os.example

# OpenAI / Anthropic API key for AI copilot
OPENAI_API_KEY=sk-...

# Binance public endpoint (no key needed)
BINANCE_API_URL=https://api.binance.com

# Optional third-party market data providers
FEAR_GREED_URL=https://api.alternative.me/fng/
SOCRATA_COT_APP_TOKEN=...

# Sentry error tracking (leave empty to disable)
SENTRY_DSN_API=
SENTRY_DSN_ENGINE=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Engine auth — shared secret between API and engine
ENGINE_API_KEY=change_me_to_a_random_64_char_key
