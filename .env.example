# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://trading_user:trading_pass@localhost:5433/trading_os
APP_RUNTIME_DATABASE_URL=postgresql://app_runtime:CHANGE_ME_APP_RUNTIME_PASSWORD@localhost:5433/trading_os?schema=public
REDIS_URL=redis://localhost:6380

# ─── Database (Docker prod) ──────────────────────────────────
# POSTGRES_USER=root
# POSTGRES_PASSWORD=change_in_production
# POSTGRES_DB=app
# APP_RUNTIME_USER=app_runtime
# APP_RUNTIME_PASSWORD=change_me_app_runtime_password

# ─── API ────────────────────────────────────────────────────
API_PORT=3001
# Port hôte exposé en prod (docker-compose.prod.yml)
# API_PORT_HOST=3002
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=7d
ADMIN_PASSWORD=change_this_admin_password
SENTRY_DSN_API=
SENTRY_TRACES_SAMPLE_RATE=0.1
ENCRYPTION_KEY=
ENCRYPTION_SALT=
# Cookies auth en HTTPS (1 en prod derrière TLS, 0 en local)
# COOKIE_SECURE=0
# Bloque toutes les routes sauf /health et /metrics (1 = activé)
# MAINTENANCE_MODE=0
# Token Bearer requis sur GET /metrics (laisser vide = endpoint ouvert)
# METRICS_TOKEN=
# Confiance minimale (%) pour l'exécution auto des signaux par l'AutoTrader
# AUTO_TRADER_MIN_CONFIDENCE=70
# NODE_ENV=development

# ─── Python Engine ──────────────────────────────────────────
ENGINE_URL=http://localhost:8000
ENGINE_PORT=8000
ENGINE_API_KEY=change_this_engine_key
SENTRY_DSN_ENGINE=
# URL de l'API NestJS vue par l'engine (push notifications internes)
# API_URL=http://api:3001
# Origines CORS autorisées sur l'engine (séparées par des virgules)
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Tag de version renvoyé dans les réponses engine
# ENGINE_VERSION=0.1.0
# Risk engine — capital de référence et risque par trade
# RISK_INITIAL_CAPITAL=10000
# RISK_BASE_PCT=1.0

# ─── Frontend ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3003
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05

# ─── Monitoring (Loki + Grafana) ────────────────────────────
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password

# ─── Market Data APIs ───────────────────────────────────────
# Mettre tes vraies clés dans le fichier `.env` (jamais ici)
BINANCE_API_KEY=
BINANCE_API_SECRET=
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=
DERIV_API_TOKEN=
# ── Deriv (nouvelle API api.derivws.com) ──
# Endpoint WS market data (public, sans auth) — ne changer que si Deriv migre
# DERIV_WS_URL=wss://api.derivws.com/trading/v1/options/ws/public
# Budget requêtes/min côté client (limite Deriv ~220/min)
# DERIV_MAX_RPM=180
# Trading live (flux OTP) — voir developers.deriv.com/docs/options
# DERIV_APP_ID=          # ID d'app (dashboard developers.deriv.com → Register app)
# DERIV_ACCOUNT_ID=      # ID compte Options (ex. DOT90004580, VRTC…, CR…)
# DERIV_API_TOKEN ci-dessus sert de Bearer pour POST .../otp (scope trade requis)
# Fallback relais candles (Cloudflare Worker apps/engine/workers/deriv-relay)
# utilisé uniquement si le WS direct échoue — optionnel aujourd'hui
# DERIV_PROXY_URL=https://xxx.workers.dev
# DERIV_PROXY_KEY=

# On-chain / social / funding (Phase A+)
# Coinalyze — liquidations, OI, funding, long/short (40 req/min gratuit)
# https://coinalyze.net/account/api-key/
COINALYZE_API_KEY=
# DexScreener — DEX pairs, new tokens, trending (free, no key, 300 req/min)
# https://docs.dexscreener.com/api/reference
DEXSCREENER_API_KEY=
# GeckoTerminal — DEX pools, OHLCV, new pools (free, no key, 10 req/min)
# https://www.geckoterminal.com/dex-api
GECKOTERMINAL_API_KEY=
# Etherscan — active addresses ETH (free tier)
# https://etherscan.io/myapikey
ETHERSCAN_API_KEY=
# LunarCrush — sentiment social crypto + stocks (500 req/jour gratuit)
LUNARCRUSH_API_KEY=
# Massive (massive.com) — proxy données crypto/stocks/forex (Bearer)
MASSIVE_API_KEY=

# ─── AI / LLM ───────────────────────────────────────────────
# Option 1 : OpenAI-compatible (cloud)
#   OpenAI  : OPENAI_BASE_URL=https://api.openai.com/v1  + OPENAI_MODEL=gpt-4o
#   Groq    : OPENAI_BASE_URL=https://api.groq.com/openai/v1 + OPENAI_MODEL=openai/gpt-oss-120b (gratuit)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# Option 2 : Ollama (local, gratuit) — lance `ollama serve` puis `ollama pull llama3.2`
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# Ollama derrière Cloudflare Access (Zero Trust) :
# OLLAMA_CF_ACCESS_CLIENT_ID=
# OLLAMA_CF_ACCESS_CLIENT_SECRET=
# Timeout des appels Ollama en secondes (défaut 20)
# OLLAMA_TIMEOUT_S=20

# Quota quotidien de messages IA par utilisateur (admin illimité)
# LLM_DAILY_QUOTA=30

# ─── News / Sentiment ───────────────────────────────────────
# newsapi.org — plan gratuit: 100 req/jour (suffisant en dev, cache 15 min)
# Cache actif : 15 min par actif → ~6-8 appels/heure en production
# Inscription gratuite : https://newsapi.org/register
# Mettre ta vraie clé dans `.env` (jamais ici)
# Fonctionnalités activées : sentiment NLP ±10pts confiance, news dans signaux, RAG auto
NEWS_API_KEY=


# Signal distribution
TELEGRAM_BOT_TOKEN=
# Chat ID du groupe/channel Telegram où diffuser les alertes signaux (ex: -1001234567890 ou @monchannel)
TELEGRAM_GROUP_CHAT_ID=

# Web Push (générer avec: npx web-push generate-vapid-keys)
# VAPID_SUBJECT doit être un email ou une URL (ex: mailto:contact@trading-os.local ou https://trading-os.local)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Exchange execution (set to true for testnet)
BINANCE_USE_TESTNET=false

# OANDA (set to true for practice/demo account)
OANDA_USE_PRACTICE=true

# MT5 Bridge — Python microservice URL (must be running on VPS with MT5 Terminal)
MT5_BRIDGE_URL=http://localhost:8001

# ─── Phase M — X (Twitter) API v2 ─────────────────────────────
# https://developer.x.com/en/portal/dashboard
# Free tier: 100 tweets/month read, 1 app
# Basic tier ($100/mo): 10k tweets/month read
X_BEARER_TOKEN=

# ─── Phase N — Pre-listing alpha ──────────────────────────────
# CryptoRank — IDO/IEO/ICO fundraising data (free tier available)
# https://cryptorank.io/api
CRYPTORANK_API_KEY=
# ParseHub — listings pré-launch scrapés (pre_listing router)
PARSE_API_KEY=
# TokenUnlocks — vesting/unlock schedules
TOKENUNLOCKS_API_KEY=
# CryptoPanic — news crypto agrégées (pre_listing)
CRYPTOPANIC_API_KEY=
# GitHub PAT — activité développeur des projets (repos/commits)
GITHUB_TOKEN=

# ─── Phase P — On-chain pre-listing signals ───────────────────
# Whale Alert — large crypto transactions tracking (free tier: 10 req/min)
# https://whale-alert.io/developer
WHALE_ALERT_API_KEY=
# CryptoQuant — flux baleines/échanges (whale_tracker)
CRYPTOQUANT_API_KEY=

# CryptoMiso — GitHub commits per crypto project (free, no key)
# https://www.cryptomiso.com
# No API key needed

# Solscan — Solana on-chain data (free tier)
# https://docs.solscan.xyz
SOLSCAN_API_KEY=

# financialmodelingprep
FMP_API_KEY=

# ─── Auth Hardening ───────────────────────────────────────────
# Max failed login attempts before lockout (default 5)
MAX_FAILED_LOGINS=5
# Lockout duration in minutes (default 15)
LOCKOUT_MINUTES=15
# Frontend URL used in email verification links
FRONTEND_URL=http://localhost:3000

# ─── Email / SMTP (required for email verification) ───────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@trading-os.local