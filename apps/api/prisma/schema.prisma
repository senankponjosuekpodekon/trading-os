generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SignalFeature {
  id         String        @id @default(cuid())
  signalId   String        @unique @map("signal_id")
  features   Json          @map("features_json")
  embedding  Json?         @map("embedding_vector")
  concept    Json?         @map("concept_vector")
  symbol     String?       @map("symbol")
  market     String?       @map("market")
  timeframe  String?       @map("timeframe")
  direction  SignalType?   @map("signal_type")
  confidence Float?        @map("confidence")
  mlConfidence Float?      @map("ml_confidence")
  mlRegime   String?       @map("ml_regime")
  expectedMove Json?       @map("expected_move_json")
  snapshotVersion String   @default("v2") @map("snapshot_version")
  source     String?       @map("source")
  outcome    SignalOutcome?
  pnl        Float?
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  signal     Signal        @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@map("signal_features")
  @@index([market, timeframe], map: "signal_features_market_timeframe_idx")
  @@index([direction, outcome], map: "signal_features_direction_outcome_idx")
}

// ─── USERS ───────────────────────────────────────────────────

enum UserRole {
  TRADER
  INVESTOR
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  CANCELLED
  PAST_DUE
  EXPIRED
}

enum BillingInterval {
  MONTH
  YEAR
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  password     String
  name         String
  role         UserRole       @default(TRADER)
  isActive     Boolean        @default(true)
  totpSecret   String?        @map("totp_secret")
  totpEnabled  Boolean        @default(false) @map("totp_enabled")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  portfolios   Portfolio[]
  journal      JournalEntry[]
  strategies   UserStrategy[]
  refreshTokens RefreshToken[]
  subscriptions Subscription[]
  labSessions  LabSession[]
  notifications Notification[]
  priceAlerts  PriceAlert[]
  auditLogs    AuditLog[]
  feedbacks    SignalFeedback[]
  signalUsage  SignalDailyUsage[]

  @@map("users")
}

model Plan {
  id              String        @id @default(cuid())
  name            String
  code            String        @unique
  price           Decimal
  interval        BillingInterval
  maxStrategies   Int?          @map("max_strategies")
  maxSignals      Int?          @map("max_signals")
  maxPortfolios   Int?          @map("max_portfolios")
  features        String[]      @default([])
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  subscriptions   Subscription[]

  @@map("plans")
}

model Subscription {
  id              String             @id @default(cuid())
  userId          String             @map("user_id")
  planId          String             @map("plan_id")
  status          SubscriptionStatus @default(TRIAL)
  currentPeriodStart DateTime        @map("current_period_start")
  currentPeriodEnd   DateTime        @map("current_period_end")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            Plan               @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@index([planId])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

model RefreshToken {
  id           String    @id @default(cuid())
  tokenHash    String    @unique @map("token_hash")
  userId       String    @map("user_id")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedBy   String?   @map("replaced_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  userAgent    String?   @map("user_agent")
  ip           String?   @map("ip")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ─── PORTFOLIOS ──────────────────────────────────────────────

enum PortfolioType {
  PAPER
  LIVE
}

model Portfolio {
  id           String        @id @default(cuid())
  name         String
  type         PortfolioType @default(PAPER)
  currency     String        @default("USD")
  initialCapital Decimal     @default(10000)
  currentCapital Decimal     @default(10000)
  userId       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions    Position[]

  @@index([userId])
  @@map("portfolios")
}

// ─── MARKETS & ASSETS ────────────────────────────────────────

enum MarketType {
  CRYPTO
  FOREX
  STOCKS
  INDICES
  COMMODITIES
  SYNTHETIC
}

model Market {
  id           String     @id @default(cuid())
  name         String     @unique
  type         MarketType
  isActive     Boolean    @default(true)

  assets       Asset[]

  @@map("markets")
}

model Asset {
  id           String   @id @default(cuid())
  symbol       String   @unique
  name         String
  marketId     String
  baseCurrency String   @default("USD")
  isActive     Boolean  @default(true)
  metadata     Json?

  market       Market   @relation(fields: [marketId], references: [id])
  signals      Signal[]
  positions    Position[]

  @@map("assets")
}

// ─── STRATEGIES ──────────────────────────────────────────────

enum SignalType {
  BUY
  SELL
  NEUTRAL
}

model Strategy {
  id              String   @id @default(cuid())
  name            String   @unique
  description     String?
  rules           Json
  analysisTimeframe String?  @map("analysis_timeframe")
  entryTimeframe    String?  @map("entry_timeframe")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  signals      Signal[]
  userStrategies UserStrategy[]

  @@map("strategies")
}

model UserStrategy {
  id           String   @id @default(cuid())
  userId       String
  strategyId   String
  isEnabled    Boolean  @default(true)
  customRules  Json?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy     Strategy @relation(fields: [strategyId], references: [id])

  @@unique([userId, strategyId])
  @@map("user_strategies")
}

// ─── SIGNALS ─────────────────────────────────────────────────

// Cycle de vie du déclenchement (Sprint 3 — modes d'entrée & invalidation).
// PENDING     : setup RETEST/LIMIT en attente que le prix atteigne entryPrice.
// ACTIVE      : déclencheur satisfait (ou trigger BREAKOUT immédiat) — signal exploitable.
// INVALIDATED : setup expiré (expiresAt dépassé) ou invalidation déclenchée avant activation.
enum SignalStatus {
  PENDING
  ACTIVE
  INVALIDATED
}

model Signal {
  id           String       @id @default(cuid())
  assetId      String
  strategyId   String
  signal       SignalType
  confidence   Float
  timeframe    String
  entryPrice   Decimal?
  stopLoss     Decimal?
  takeProfit1  Decimal?
  takeProfit2  Decimal?
  riskReward        Float?
  profileSuitability String[] @default([])
  qualityScore     Float?        @map("quality_score")
  status       SignalStatus @default(ACTIVE)
  indicators   Json?
  metadata     Json?
  explanation  String?
  isActive     Boolean    @default(true)
  expiresAt    DateTime?
  createdAt    DateTime   @default(now())

  asset        Asset      @relation(fields: [assetId], references: [id])
  strategy     Strategy   @relation(fields: [strategyId], references: [id])
  positions    Position[]
  feedbacks    SignalFeedback[]
  featureSnapshot SignalFeature?

  @@index([assetId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([isActive, createdAt(sort: Desc)])
  @@index([strategyId, createdAt(sort: Desc)])
  @@index([status])
  @@index([profileSuitability])
  @@map("signals")
}

model SignalFeedback {
  id        String   @id @default(cuid())
  signalId  String   @map("signal_id")
  userId    String   @map("user_id")
  grade     Int      // 1 to 5
  comment   String?
  outcome   Float?   // realized P&L % if available
  createdAt DateTime @default(now()) @map("created_at")
  signal    Signal   @relation(fields: [signalId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([signalId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("signal_feedbacks")
}

// ─── POSITIONS ───────────────────────────────────────────────

// PARTIAL (Sprint 5) : TP1 atteint sur une position avec takeProfit2 défini —
// moitié de la quantité clôturée, SL déplacé au breakeven, reste ouvert vers TP2.
enum PositionStatus {
  OPEN
  PARTIAL
  CLOSED
  CANCELLED
}

model Position {
  id           String         @id @default(cuid())
  portfolioId  String
  assetId      String
  signalId     String?
  status       PositionStatus @default(OPEN)
  direction    SignalType
  entryPrice   Decimal
  exitPrice    Decimal?
  quantity     Decimal        // taille courante ouverte (réduite après un partial exit)
  originalQuantity Decimal?   // taille initiale — dénominateur stable pour le PnL% total (Sprint 5)
  stopLoss     Decimal?
  takeProfit   Decimal?       // TP1
  takeProfit2  Decimal?       // Sprint 5 — second palier, déclenche le partial close
  trailingStop Decimal?
  trailingMethod String?       @default("atr") // atr | swing | ema | chandelier
  trailingActive Boolean     @default(true)
  partialExitPrice Decimal?   // prix de clôture de la première moitié
  partialExitAt    DateTime?
  partialPnl       Decimal?   // PnL réalisé sur la moitié clôturée au TP1
  pnl          Decimal?
  pnlPercent   Float?
  openedAt     DateTime       @default(now())
  closedAt     DateTime?

  portfolio    Portfolio      @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset        Asset          @relation(fields: [assetId], references: [id])
  signal       Signal?        @relation(fields: [signalId], references: [id])
  journal      JournalEntry[]

  @@index([portfolioId])
  @@index([portfolioId, status])
  @@index([assetId])
  @@index([assetId, status])
  @@index([signalId])
  @@index([status])
  @@index([openedAt(sort: Desc)])
  @@map("positions")
}

// ─── SIGNAL LOG (calibration pipeline) ──────────────────────
// Enregistre chaque signal généré avec tous ses sous-scores,
// puis met à jour l'outcome réel quand TP/SL est touché.

enum SignalOutcome {
  PENDING
  WIN_TP1
  WIN_TP2
  LOSS_SL
  EXPIRED
}

model SignalLog {
  id              String        @id @default(cuid())
  signalId        String?       @map("signal_id")
  symbol          String
  timeframe       String
  signalType      SignalType    @map("signal_type")
  confidence      Float
  entryPrice      Decimal       @map("entry_price")
  stopLoss        Decimal?      @map("stop_loss")
  takeProfit1     Decimal?      @map("take_profit_1")
  takeProfit2     Decimal?      @map("take_profit_2")
  riskReward      Float?        @map("risk_reward")

  // Sous-scores par couche (pour calibration régression logistique)
  scoreTrend      Float?        @map("score_trend")
  scorePA         Float?        @map("score_pa")
  scoreSR         Float?        @map("score_sr")
  scorePatterns   Float?        @map("score_patterns")
  scoreRegime     Float?        @map("score_regime")
  scoreSMC        Float?        @map("score_smc")
  scoreMTF        Float?        @map("score_mtf")
  scoreSentiment  Float?        @map("score_sentiment")
  scoreTotal      Float         @map("score_total")
  regime          String?
  adx             Float?
  market          String?       // CRYPTO | FOREX | METALS | BRVM

  // Pattern snapshot (Sprint 7 / Phase B feedback loop)
  patternName             String?  @map("pattern_name")
  patternConfluenceScore  Float?   @map("pattern_confluence_score")
  patternConfluenceTags   String[] @default([]) @map("pattern_confluence_tags")

  // Enriched snapshot for calibration / ML / Copilot explanations
  featureVector   Json?         @map("feature_vector")
  metadata        Json?         // marketContext, detectedPatterns, decisionTrace

  // Post-trade scoring
  expectedPnlPct  Float?        @map("expected_pnl_pct")
  realizedPnlPct  Float?        @map("realized_pnl_pct")
  postTradeScore  Float?        @map("post_trade_score") // realized / expected ratio

  // Outcome — mis à jour par le job cron
  outcome         SignalOutcome @default(PENDING)
  outcomePrice    Decimal?      @map("outcome_price")
  outcomeAt       DateTime?     @map("outcome_at")
  barsToOutcome   Int?          @map("bars_to_outcome")

  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([symbol, timeframe, createdAt(sort: Desc)])
  @@index([outcome, createdAt(sort: Desc)])
  @@index([market, signalType, outcome])
  @@index([patternName, outcome])
  @@map("signal_logs")
}

// ─── JOURNAL ─────────────────────────────────────────────────

model JournalEntry {
  id           String    @id @default(cuid())
  userId       String
  positionId   String?
  title        String
  content      String
  emotion      String?
  grade        Int?
  tags         String[]
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  position     Position? @relation(fields: [positionId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([positionId])
  @@map("journal_entries")
}

// ─── LAB / TESTEUR ─────────────────────────────────────────────
// Sprint 6 : session de test (backtest + évaluation) pour une stratégie.

enum LabSessionStatus {
  DRAFT
  RUNNING
  COMPLETED
  ARCHIVED
}

model LabSession {
  id             String          @id @default(cuid())
  userId         String
  name           String
  symbol         String
  timeframe      String
  strategy       Json            // snapshot de la stratégie testée
  status         LabSessionStatus @default(DRAFT)
  backtestMetrics Json?          // résultats agrégés du backtest
  tradeList      Json?           // liste des trades simulés
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([createdAt(sort: Desc)])
  @@map("lab_sessions")
}

// ─── NOTIFICATIONS ───────────────────────────────────────────
// Sprint 8 : notifications persistées pour badge/historique/filtrage.

enum NotificationType {
  SIGNAL
  POSITION
  ALERT
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String
  data      Json?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([readAt])
  @@index([type, createdAt(sort: Desc)])
  @@map("notifications")
}

model SignalDailyUsage {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  date        DateTime @map("date")
  signalsUsed Int      @default(0) @map("signals_used")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date], map: "signal_daily_usage_user_date_unique")
  @@index([userId, date])
  @@map("signal_daily_usage")
}

model PriceAlert {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  assetSymbol String   @map("asset_symbol")
  direction   String   // "above" | "below"
  targetPrice Decimal  @map("target_price")
  triggered   Boolean  @default(false)
  triggeredAt DateTime? @map("triggered_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, triggered])
  @@index([assetSymbol, triggered])
  @@map("price_alerts")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  action    String
  resource  String
  details   Json?    @map("details")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}
