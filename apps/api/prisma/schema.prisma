generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USERS ───────────────────────────────────────────────────

enum UserRole {
  TRADER
  INVESTOR
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  CANCELLED
  PAST_DUE
  EXPIRED
}

enum BillingInterval {
  MONTH
  YEAR
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  password     String
  name         String
  role         UserRole       @default(TRADER)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  portfolios   Portfolio[]
  journal      JournalEntry[]
  strategies   UserStrategy[]
  refreshTokens RefreshToken[]
  subscriptions Subscription[]

  @@map("users")
}

model Plan {
  id              String        @id @default(cuid())
  name            String
  code            String        @unique
  price           Decimal
  interval        BillingInterval
  maxStrategies   Int?          @map("max_strategies")
  maxSignals      Int?          @map("max_signals")
  maxPortfolios   Int?          @map("max_portfolios")
  features        String[]      @default([])
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  subscriptions   Subscription[]

  @@map("plans")
}

model Subscription {
  id              String             @id @default(cuid())
  userId          String             @map("user_id")
  planId          String             @map("plan_id")
  status          SubscriptionStatus @default(TRIAL)
  currentPeriodStart DateTime        @map("current_period_start")
  currentPeriodEnd   DateTime        @map("current_period_end")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            Plan               @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@index([planId])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

model RefreshToken {
  id           String    @id @default(cuid())
  tokenHash    String    @unique @map("token_hash")
  userId       String    @map("user_id")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedBy   String?   @map("replaced_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  userAgent    String?   @map("user_agent")
  ip           String?   @map("ip")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ─── PORTFOLIOS ──────────────────────────────────────────────

enum PortfolioType {
  PAPER
  LIVE
}

model Portfolio {
  id           String        @id @default(cuid())
  name         String
  type         PortfolioType @default(PAPER)
  currency     String        @default("USD")
  initialCapital Decimal     @default(10000)
  currentCapital Decimal     @default(10000)
  userId       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions    Position[]

  @@index([userId])
  @@map("portfolios")
}

// ─── MARKETS & ASSETS ────────────────────────────────────────

enum MarketType {
  CRYPTO
  FOREX
  STOCKS
  INDICES
  COMMODITIES
  SYNTHETIC
}

model Market {
  id           String     @id @default(cuid())
  name         String     @unique
  type         MarketType
  isActive     Boolean    @default(true)

  assets       Asset[]

  @@map("markets")
}

model Asset {
  id           String   @id @default(cuid())
  symbol       String   @unique
  name         String
  marketId     String
  baseCurrency String   @default("USD")
  isActive     Boolean  @default(true)
  metadata     Json?

  market       Market   @relation(fields: [marketId], references: [id])
  signals      Signal[]
  positions    Position[]

  @@map("assets")
}

// ─── STRATEGIES ──────────────────────────────────────────────

enum SignalType {
  BUY
  SELL
  NEUTRAL
}

model Strategy {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  rules        Json
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  signals      Signal[]
  userStrategies UserStrategy[]

  @@map("strategies")
}

model UserStrategy {
  id           String   @id @default(cuid())
  userId       String
  strategyId   String
  isEnabled    Boolean  @default(true)
  customRules  Json?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy     Strategy @relation(fields: [strategyId], references: [id])

  @@unique([userId, strategyId])
  @@map("user_strategies")
}

// ─── SIGNALS ─────────────────────────────────────────────────

model Signal {
  id           String     @id @default(cuid())
  assetId      String
  strategyId   String
  signal       SignalType
  confidence   Float
  timeframe    String
  entryPrice   Decimal?
  stopLoss     Decimal?
  takeProfit1  Decimal?
  takeProfit2  Decimal?
  riskReward        Float?
  profileSuitability String[] @default([])
  indicators   Json?
  metadata     Json?
  explanation  String?
  isActive     Boolean    @default(true)
  expiresAt    DateTime?
  createdAt    DateTime   @default(now())

  asset        Asset      @relation(fields: [assetId], references: [id])
  strategy     Strategy   @relation(fields: [strategyId], references: [id])
  positions    Position[]

  @@index([assetId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("signals")
}

// ─── POSITIONS ───────────────────────────────────────────────

enum PositionStatus {
  OPEN
  CLOSED
  CANCELLED
}

model Position {
  id           String         @id @default(cuid())
  portfolioId  String
  assetId      String
  signalId     String?
  status       PositionStatus @default(OPEN)
  direction    SignalType
  entryPrice   Decimal
  exitPrice    Decimal?
  quantity     Decimal
  stopLoss     Decimal?
  takeProfit   Decimal?
  trailingStop Decimal?
  pnl          Decimal?
  pnlPercent   Float?
  openedAt     DateTime       @default(now())
  closedAt     DateTime?

  portfolio    Portfolio      @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset        Asset          @relation(fields: [assetId], references: [id])
  signal       Signal?        @relation(fields: [signalId], references: [id])
  journal      JournalEntry[]

  @@index([portfolioId])
  @@index([portfolioId, status])
  @@index([assetId])
  @@index([status])
  @@map("positions")
}

// ─── SIGNAL LOG (calibration pipeline) ──────────────────────
// Enregistre chaque signal généré avec tous ses sous-scores,
// puis met à jour l'outcome réel quand TP/SL est touché.

enum SignalOutcome {
  PENDING
  WIN_TP1
  WIN_TP2
  LOSS_SL
  EXPIRED
}

model SignalLog {
  id              String        @id @default(cuid())
  signalId        String?       @map("signal_id")
  symbol          String
  timeframe       String
  signalType      SignalType    @map("signal_type")
  confidence      Float
  entryPrice      Decimal       @map("entry_price")
  stopLoss        Decimal?      @map("stop_loss")
  takeProfit1     Decimal?      @map("take_profit_1")
  takeProfit2     Decimal?      @map("take_profit_2")
  riskReward      Float?        @map("risk_reward")

  // Sous-scores par couche (pour calibration régression logistique)
  scoreTrend      Float?        @map("score_trend")
  scorePA         Float?        @map("score_pa")
  scoreSR         Float?        @map("score_sr")
  scorePatterns   Float?        @map("score_patterns")
  scoreRegime     Float?        @map("score_regime")
  scoreSMC        Float?        @map("score_smc")
  scoreMTF        Float?        @map("score_mtf")
  scoreSentiment  Float?        @map("score_sentiment")
  scoreTotal      Float         @map("score_total")
  regime          String?
  adx             Float?
  market          String?       // CRYPTO | FOREX | METALS | BRVM

  // Outcome — mis à jour par le job cron
  outcome         SignalOutcome @default(PENDING)
  outcomePrice    Decimal?      @map("outcome_price")
  outcomeAt       DateTime?     @map("outcome_at")
  barsToOutcome   Int?          @map("bars_to_outcome")

  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([symbol, timeframe, createdAt(sort: Desc)])
  @@index([outcome, createdAt(sort: Desc)])
  @@index([market, signalType, outcome])
  @@map("signal_logs")
}

// ─── JOURNAL ─────────────────────────────────────────────────

model JournalEntry {
  id           String    @id @default(cuid())
  userId       String
  positionId   String?
  title        String
  content      String
  emotion      String?
  grade        Int?
  tags         String[]
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  position     Position? @relation(fields: [positionId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([positionId])
  @@map("journal_entries")
}
